{
  "name": "am-investments-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform all --max-workers 2",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "sync:properties": "python3 scripts/sync_properties.py",
    "test:ui": "node scripts/smoke-web.mjs",
    "postinstall": "node scripts/prepare_brand_assets.mjs",
    "export:inventory": "node scripts/export_inventory.mjs",
    "check:native-release": "node scripts/verify_native_release.mjs",
    "eas-build-post-install": "node scripts/verify_native_release.mjs --eas-hook"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "playwright": "^1.58.0",
    "typescript": "~6.0.3"
  }
}
